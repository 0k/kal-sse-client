{
  "name": "@0k/kal-sse-client",
  "version": "%%version%%",
  "description": "Framework-agnostic browser client for kal-sse snapshot and server-owned cursor channels.",
  "keywords": [
    "sse",
    "server-sent-events",
    "eventsource",
    "kal-sse",
    "reconnect",
    "resume",
    "snapshot"
  ],
  "author": "Valentin Lab <valentin.lab@kalysto.org>",
  "license": "MIT",
  "homepage": "https://github.com/0k/kal-sse-client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0k/kal-sse-client.git"
  },
  "bugs": {
    "url": "https://github.com/0k/kal-sse-client/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "npm run test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
